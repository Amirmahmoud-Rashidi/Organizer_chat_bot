# =============================================================================
# Organizer Chat Bot — Environment Configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` (it's in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Telegram USER credentials (from https://my.telegram.org/apps)
# These are for the Telethon userbot (the account that READS chats).
# Different from the BotFather token below.
# -----------------------------------------------------------------------------
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=organizer_userbot

# -----------------------------------------------------------------------------
# 2) BotFather token (for the interface bot)
# Get it from @BotFather on Telegram via /newbot.
# -----------------------------------------------------------------------------
BOT_TOKEN=123456789:AA-your-botfather-token-here

# -----------------------------------------------------------------------------
# 3) Authorization — User ID that can use the bot
# Get yours from @userinfobot or @RawDataBot on Telegram.
# Anyone else will be silently ignored.
# -----------------------------------------------------------------------------
ALLOWED_USER_ID=111111111

# Default destination chat for forwarded matches (can be overridden per-run).
# Use @channel_username or a numeric chat ID like -1001234567890.
FORWARD_DESTINATION=@your_destination_chat

# -----------------------------------------------------------------------------
# 4) AI Provider — provide EXACTLY ONE of the two API keys below.
# The bot auto-detects which provider to use at startup.
# DO NOT set both at the same time (the bot will refuse to start).
# -----------------------------------------------------------------------------

# Option A: OpenRouter (https://openrouter.ai) — recommended default
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash

# Option B: Google AI Studio (https://aistudio.google.com) — has a free tier
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# 5) Optional settings
# -----------------------------------------------------------------------------
# Default language for new sessions: "fa" or "en"
DEFAULT_LANGUAGE=fa

# Max messages fetched per run (hard cap; pagination is enabled by default)
MAX_MESSAGES_PER_RUN=1000

# How many recent prompts to keep in Saved Messages
PROMPT_HISTORY_LIMIT=10

# -----------------------------------------------------------------------------
# 6) Read pacing (anti-FloodWait / anti-ban)
# -----------------------------------------------------------------------------
# These control the "slow read" mode that makes the bot's request pattern
# look more like a human user — drastically reduces the risk of
# FloodWaitError and account restrictions.
#
# The defaults below are conservative and SAFE:
#   * 10 messages per second (FAST_BATCH_SIZE messages, then FAST_BATCH_DELAY seconds)
#   * + a longer 5-second pause every 50 messages (BATCH_SIZE / LONG_PAUSE_DELAY)
#
# To make reads FASTER (higher throughput, higher risk), increase
# FAST_BATCH_SIZE and/or decrease FAST_BATCH_DELAY. To make reads SAFER
# (slower but lower risk), do the opposite.
#
# Examples (slower/safer):
#   FAST_BATCH_SIZE=5   FAST_BATCH_DELAY=1.0
#   FAST_BATCH_SIZE=20  FAST_BATCH_DELAY=2.0
#
# Set SLOW_READ_ENABLED=false to disable pacing entirely (NOT recommended).
# -----------------------------------------------------------------------------
SLOW_READ_ENABLED=true
FAST_BATCH_SIZE=10
FAST_BATCH_DELAY=1.0
BATCH_SIZE=50
LONG_PAUSE_DELAY=5.0

# -----------------------------------------------------------------------------
# 6) Optional override
# -----------------------------------------------------------------------------
# Override where the Telethon session file is stored. Defaults to ./data
# (relative to CWD), which works both locally and inside Docker.
# TELEGRAM_SESSION_DIR=/custom/path

# -----------------------------------------------------------------------------
# 7) Telethon userbot proxy (advanced, OFF by default)
# -----------------------------------------------------------------------------
# If you're on a network where Telegram's IPs are unreachable, enable
# this and point it at a SOCKS5 or HTTP proxy. The HTTPS traffic from
# the BotFather and AI SDKs is handled separately by Chrome-Tunnel
# (auto-detected at 127.0.0.1:8765) — see README for details.
#
# Examples:
#   - Local SOCKS5 proxy from a VPN app: 127.0.0.1:1080
#   - SSH dynamic port forward:          127.0.0.1:1080
#   - Public SOCKS5 (NOT recommended):    some-proxy.com:1080
#
# TELEGRAM_PROXY_ENABLED=false
# TELEGRAM_PROXY_TYPE=socks5            # socks5 or http
# TELEGRAM_PROXY_HOST=127.0.0.1
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_PROXY_USERNAME=              # leave empty if no auth
# TELEGRAM_PROXY_PASSWORD=              # leave empty if no auth
# TELEGRAM_PROXY_RDNS=true              # resolve DNS through proxy (socks5)

# -----------------------------------------------------------------------------
# 8) HTTPS proxy (for BotFather + AI SDKs)
# -----------------------------------------------------------------------------
# By default, main.py auto-detects a local HTTP proxy on common ports
# (127.0.0.1:8765 = Chrome-Tunnel, 8080, 8888) and routes HTTPS through it.
# Set this explicitly if your proxy lives elsewhere or needs auth.
#
# HTTPS_PROXY=http://user:pass@proxy-host:8080
# NO_PROXY=localhost,127.0.0.1